---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Use the wide container for grid/landing pages; posts stay narrow. */
  wide?: boolean;
}

const {
  title,
  description = 'Explanatory, interactive posts on space and orbital physics.',
  wide = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: 'Home' },
  { href: `${base}#blogs`, label: 'Articles' },
  { href: `${base}viewer`, label: 'Viewer' },
  { href: `${base}about`, label: 'About' },
];
const container = wide ? 'max-w-6xl' : 'max-w-3xl';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-5">
      <header class="flex items-center justify-between py-5">
        <a
          href={base}
          class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-ink-900"
        >
          <img src={`${base}favicon.svg`} alt="" width="30" height="30" class="rounded-lg" />
          <span style="font-family: var(--font-display)">Orbital Notes</span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-medium text-ink-500 sm:flex">
          {
            nav.map((item) => (
              <a class="transition hover:text-ink-900" href={item.href}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          href={`${base}viewer`}
          class="rounded-full bg-brand-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-600"
        >
          Open viewer
        </a>
      </header>

      <main class={`mx-auto w-full flex-1 py-6 ${container}`}>
        <slot />
      </main>

      <footer class="mt-12 border-t border-line py-10">
        <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
          <a href={base} class="flex items-center gap-2.5 font-bold text-ink-900">
            <img src={`${base}favicon.svg`} alt="" width="26" height="26" class="rounded-md" />
            <span style="font-family: var(--font-display)">Orbital Notes</span>
          </a>
          <nav class="flex flex-wrap items-center justify-center gap-6 text-sm text-ink-500">
            {
              nav.map((item) => (
                <a class="transition hover:text-ink-900" href={item.href}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="flex items-center gap-3 text-ink-400">
            <a
              href="https://github.com/nadavzoh/blog"
              target="_blank"
              rel="noopener"
              aria-label="GitHub repository"
              class="transition hover:text-ink-900"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.15v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
                />
              </svg>
            </a>
            <a
              href="https://celestrak.org/"
              target="_blank"
              rel="noopener"
              aria-label="CelesTrak"
              class="transition hover:text-ink-900"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <circle cx="12" cy="12" r="3.2" />
                <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(-25 12 12)" />
              </svg>
            </a>
          </div>
        </div>
        <p class="mt-8 text-center text-sm text-ink-400">
          © {new Date().getFullYear()} Orbital Notes — a friendly tour of how things fly through
          space. Built with Astro, React islands & KaTeX.
        </p>
      </footer>
    </div>
  </body>
</html>
