---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, order } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Orbital Notes`} description={description}>
  <article class="prose">
    <a href={import.meta.env.BASE_URL} class="text-sm text-nebula-400 no-underline hover:text-aurora-400">
      ← Back to all posts
    </a>

    <header class="mt-6 mb-10 border-b border-void-800 pb-8">
      <p class="mb-3 text-sm font-medium uppercase tracking-wider text-aurora-400">
        Part {order} of the series
      </p>
      <h1 class="!mt-0 text-3xl font-extrabold sm:text-4xl">{title}</h1>
      <p class="!mt-3 text-lg text-star-400">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-star-400">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {
          tags.length > 0 && (
            <span class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full bg-void-800 px-2.5 py-0.5 text-xs text-nebula-400">
                  #{tag}
                </span>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <slot />
  </article>
</BaseLayout>
