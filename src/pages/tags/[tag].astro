---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getArticles,
  tagsOf,
  tagSlug,
  topicOf,
  articleSlug,
  formatDate,
  articleDate,
} from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  const tags = tagsOf(articles);
  return tags.map((tag) => {
    const matches = articles.filter((a) => a.data.tags.includes(tag));
    return { params: { tag: tagSlug(tag) }, props: { tag, articles: matches } };
  });
}

const base = import.meta.env.BASE_URL;
const { tag, articles } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Articles tagged ${tag}.`}>
  <nav class="flex items-center gap-1.5 text-sm font-medium text-ink-500" aria-label="Breadcrumb">
    <a href={base} class="transition hover:text-brand-600">Home</a>
    <span aria-hidden="true">/</span>
    <a href={`${base}tags`} class="transition hover:text-brand-600">Tags</a>
  </nav>

  <h1
    class="mt-6 text-4xl font-extrabold tracking-tight text-ink-900 sm:text-5xl"
    style="font-family: var(--font-display)"
  >
    #{tag}
  </h1>

  <ul class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      articles.map((article) => {
        const date = articleDate(article);
        return (
          <li>
            <a
              href={`${base}${topicOf(article)}/${articleSlug(article)}`}
              class="group card card-hover flex h-full flex-col p-5"
            >
              <span class="text-xs font-medium text-brand-600">{topicOf(article)}</span>
              <h2 class="mt-1 text-base font-bold leading-snug text-ink-900 transition group-hover:text-brand-600">
                {article.data.title}
              </h2>
              <p class="mt-2 line-clamp-2 text-sm text-ink-500">{article.data.description}</p>
              {date && (
                <time datetime={date.toISOString()} class="mt-auto pt-4 text-xs text-ink-400">
                  Updated {formatDate(date)}
                </time>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
