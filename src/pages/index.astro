---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import {
  getTopics,
  getArticles,
  getArticlesByTopic,
  assertArticlesHaveTopics,
  topicOf,
  articleSlug,
  coverFor,
  formatDate,
  articleDate,
} from '../lib/content';

await assertArticlesHaveTopics();

const base = import.meta.env.BASE_URL;
const topics = await getTopics();

// Per-topic article counts.
const counts = new Map<string, number>();
for (const topic of topics) {
  counts.set(topic.id, (await getArticlesByTopic(topic.id)).length);
}

// Recently updated articles across all topics.
const articles = await getArticles();
const recent = articles
  .filter((a) => articleDate(a))
  .sort((a, b) => (articleDate(b)!.getTime() - articleDate(a)!.getTime()))
  .slice(0, 6);
---

<BaseLayout wide>
  <section class="py-10 text-center sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{SITE.name}</p>
    <h1
      class="mx-auto mt-4 max-w-3xl text-4xl font-extrabold leading-[1.1] tracking-tight text-ink-900 sm:text-5xl"
      style="font-family: var(--font-display)"
    >
      A topic-first knowledge base.
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-500">{SITE.description}</p>
  </section>

  <section id="topics" class="mt-8 scroll-mt-24">
    <h2
      class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      style="font-family: var(--font-display)"
    >
      Browse by topic
    </h2>
    {
      topics.length === 0 ? (
        <p class="mt-4 text-ink-500">No topics yet. Add one in <code>src/content/topics/</code>.</p>
      ) : (
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {topics.map((topic) => (
            <li>
              <a href={`${base}${topic.id}`} class="group card card-hover flex h-full flex-col overflow-hidden">
                <div class="relative">
                  <img src={coverFor(topic, base)} alt="" class="cover" loading="lazy" />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="text-lg font-bold leading-snug text-ink-900 transition group-hover:text-brand-600">
                    {topic.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm text-ink-500">{topic.data.description}</p>
                  <span class="mt-auto pt-4 text-xs font-medium text-ink-400">
                    {counts.get(topic.id) ?? 0} article{(counts.get(topic.id) ?? 0) === 1 ? '' : 's'}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    recent.length > 0 && (
      <section class="mt-16">
        <h2
          class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl"
          style="font-family: var(--font-display)"
        >
          Recently updated
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {recent.map((article) => {
            const date = articleDate(article)!;
            return (
              <li>
                <a
                  href={`${base}${topicOf(article)}/${articleSlug(article)}`}
                  class="group flex items-center justify-between gap-4 rounded-xl border border-line bg-card px-4 py-3 transition hover:border-line-strong"
                >
                  <div class="min-w-0">
                    <p class="truncate font-semibold text-ink-900 transition group-hover:text-brand-600">
                      {article.data.title}
                    </p>
                    <p class="truncate text-sm text-ink-500">{article.data.description}</p>
                  </div>
                  <time datetime={date.toISOString()} class="shrink-0 text-xs text-ink-400">
                    {formatDate(date)}
                  </time>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</BaseLayout>
