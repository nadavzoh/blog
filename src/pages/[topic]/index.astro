---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import {
  getTopics,
  getArticlesByTopic,
  assertArticlesHaveTopics,
  articleSlug,
  formatDate,
  articleDate,
} from '../../lib/content';
import { RESERVED_SLUGS } from '../../site.config';

export async function getStaticPaths() {
  await assertArticlesHaveTopics();
  const topics = await getTopics();
  for (const topic of topics) {
    if (RESERVED_SLUGS.includes(topic.id)) {
      throw new Error(
        `Topic slug "${topic.id}" collides with a reserved top-level route. ` +
          `Rename the file in src/content/topics/.`,
      );
    }
  }
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const base = import.meta.env.BASE_URL;
const { topic } = Astro.props;
const { Content } = await render(topic);
const articles = await getArticlesByTopic(topic.id);
---

<BaseLayout title={topic.data.title} description={topic.data.description} wide>
  <nav class="flex items-center gap-1.5 text-sm font-medium text-ink-500" aria-label="Breadcrumb">
    <a href={base} class="transition hover:text-brand-600">Home</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink-700">{topic.data.title}</span>
  </nav>

  <header class="mt-6 max-w-3xl">
    <h1
      class="text-4xl font-extrabold leading-tight tracking-tight text-ink-900 sm:text-5xl"
      style="font-family: var(--font-display)"
    >
      {topic.data.title}
    </h1>
    <p class="mt-4 text-lg text-ink-500">{topic.data.description}</p>
  </header>

  <div class="prose mt-8 max-w-3xl">
    <Content />
  </div>

  <section class="mt-12">
    <h2 class="text-2xl font-bold tracking-tight text-ink-900" style="font-family: var(--font-display)">
      Articles
    </h2>
    {
      articles.length === 0 ? (
        <p class="mt-4 text-ink-500">No articles in this topic yet.</p>
      ) : (
        <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => {
            const date = articleDate(article);
            return (
              <li>
                <a
                  href={`${base}${topic.id}/${articleSlug(article)}`}
                  class="group card card-hover flex h-full flex-col p-5"
                >
                  <h3 class="text-base font-bold leading-snug text-ink-900 transition group-hover:text-brand-600">
                    {article.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-3 text-sm text-ink-500">{article.data.description}</p>
                  {date && (
                    <time
                      datetime={date.toISOString()}
                      class="mt-auto pt-4 text-xs text-ink-400"
                    >
                      Updated {formatDate(date)}
                    </time>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</BaseLayout>
